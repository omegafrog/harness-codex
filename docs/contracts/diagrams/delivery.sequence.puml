@startuml
actor 사용자
participant "runWorkspacePreflightCli" as preflight
participant "executeImplementPlan" as execute
participant "dispatchImplementPlan" as dispatch
participant "PlanCheckpointStore" as checkpoint
participant "LifecycleGateRegistry" as gates
participant "inspectTrackerSync" as inspect
participant "inspectProjectReadiness" as readiness
participant "syncTrackerStatus" as sync
participant "GitHub Workflow Status 또는 local ticket" as tracker
participant "Beads" as beads
participant "codex exec" as codex
participant "독립 reviewer" as review
participant "E2E runner" as e2e
participant "snapshotSpecReview" as snapshotReview
participant "Product Spec reviewer" as productReviewer
participant "Architecture Spec reviewer" as architectureReviewer
participant "review-attempts.mjs" as reviewAttempts
participant "inspectSpecReviews" as inspectReviews
participant "inspectPlanTraceability" as traceability
participant "독립 plan reviewer" as planReviewer
participant "to-ticket planning" as toTicket
participant "completeWorkflow" as complete
participant "finishWorkflowWorktree" as finish
participant "Private recovery archive" as archive
participant "Git worktree" as worktree
participant "session_directory" as session
participant "shared_guidance_root" as guidance
사용자 -> preflight : workspace_root 검증
preflight -> inspect : inspectTrackerSync()
inspect -> tracker : canonical 상태 읽기
inspect -> beads : mirror 상태 읽기
alt mirror 불일치 또는 조회 실패
  inspect --> preflight : fail
  preflight --> 사용자 : workspace 차단
else 검증 통과
  preflight --> 사용자 : valid
  사용자 -> execute : plan·workspace·evidence
  사용자 -> snapshotReview : raw user request·Product draft·diagrams
  snapshotReview -> snapshotReview : content hash 고정, fresh reviewer 입력 snapshot 구성
  snapshotReview -> reviewAttempts : updateReviewAttempt(action=begin, Product snapshot)
  alt admission 거부
    reviewAttempts --> snapshotReview : active slot·변경 없는 입력·재시도 한도 초과
    snapshotReview --> 사용자 : 검토 보류와 재시도 시점 안내
  else admission 허용
    reviewAttempts --> snapshotReview : attempt 허용
    snapshotReview -> productReviewer : 독립 검토 (parent context 미상속)
    productReviewer --> snapshotReview : material findings 또는 승인
    snapshotReview -> reviewAttempts : updateReviewAttempt(action=record, Product 결과)
    reviewAttempts --> snapshotReview : 기록 완료
  end
  alt material findings
    loop 최대 2회 correction rounds
      snapshotReview --> 사용자 : 의미 확인용 질문 또는 수정 요구
      사용자 -> snapshotReview : 답변·수정 Product draft
      snapshotReview -> reviewAttempts : updateReviewAttempt(action=begin, 새 Product snapshot)
      alt admission 거부
        reviewAttempts --> snapshotReview : active slot·변경 없는 입력·재시도 한도 초과
        snapshotReview --> 사용자 : 미해결 findings와 재시도 시점 안내
      else admission 허용
        reviewAttempts --> snapshotReview : attempt 허용
        snapshotReview -> productReviewer : 새 content hash snapshot으로 재검토
        productReviewer --> snapshotReview : findings 또는 승인
        snapshotReview -> reviewAttempts : updateReviewAttempt(action=record, Product 결과)
        reviewAttempts --> snapshotReview : 기록 완료
      end
    end
    opt correction budget 소진 후 미해결 findings
      snapshotReview --> 사용자 : 미해결 findings 반환
    end
  end
  opt Product pass
    snapshotReview --> 사용자 : Product Spec reviewer 승인
    사용자 -> snapshotReview : Architecture draft·source baseline
    snapshotReview -> reviewAttempts : updateReviewAttempt(action=begin, Architecture snapshot)
    alt admission 거부
      reviewAttempts --> snapshotReview : active slot·변경 없는 입력·재시도 한도 초과
      snapshotReview --> 사용자 : 검토 보류와 재시도 시점 안내
    else admission 허용
      reviewAttempts --> snapshotReview : attempt 허용
      snapshotReview -> architectureReviewer : 서로 다른 fresh reviewer (parent context 미상속)
      architectureReviewer --> snapshotReview : material findings 또는 승인
      snapshotReview -> reviewAttempts : updateReviewAttempt(action=record, Architecture 결과)
      reviewAttempts --> snapshotReview : 기록 완료
    end
  end
  snapshotReview -> inspectReviews : inspectSpecReviews()
  alt material findings 또는 stale inputs
    inspectReviews --> 사용자 : spec-me 완료 차단
    inspectReviews --> toTicket : planning 차단
  else 독립 검토 통과 및 입력 hash 일치
    inspectReviews --> 사용자 : spec-me 완료 허용
    inspectReviews --> toTicket : planning 허용
    toTicket -> traceability : snapshot(plan_set_id, ticket_id, source·계획 본문)
    traceability --> toTicket : 규칙 inventory·canonical 참조·현재 hash
    toTicket -> reviewAttempts : updateReviewAttempt(action=begin, plan set snapshot)
    alt admission 거부
      reviewAttempts --> toTicket : active slot·변경 없는 입력·재시도 한도 초과
      toTicket --> 사용자 : 계획 검토 보류와 재시도 시점 안내
    else admission 허용
      reviewAttempts --> toTicket : attempt 허용
      toTicket -> planReviewer : 전체 원문·전체 계획·원장 리뷰 (context 미상속)
      planReviewer --> toTicket : pass 또는 근거 포함 finding
      toTicket -> reviewAttempts : updateReviewAttempt(action=record, plan 결과)
      reviewAttempts --> toTicket : 기록 완료
    end
    toTicket -> traceability : check(planning, 독립 리뷰 입력 hash)
    traceability --> toTicket : 누락·stale 차단 또는 planning pass
  end
  execute -> checkpoint : read()
  checkpoint -> session : sessionDirectory(workspace_root)
  execute -> gates : before_dispatch
  gates -> readiness : inspectProjectReadiness(workspace_root)
  readiness -> readiness : EXEC.md + execution.json 전체 profile 검증, 명령 미실행
  readiness -> readiness : inspectContracts 실제 검사
  alt project_readiness 준비 미완료
    readiness --> gates : blocked, project_preparation_required
    gates --> execute : blocked
    execute --> 사용자 : agent 파견 차단 (spawnImplement 미호출)
  else project_readiness 통과
    readiness --> gates : pass
  gates -> traceability : check(dispatch, plan_id, canonical tracker 본문)
  alt 추적 근거 누락 또는 stale
    traceability --> gates : blocked
    gates --> execute : spawn 전 차단
  else 독립 계획 리뷰와 참조 일치
    traceability --> gates : pass
  gates -> inspect : inspectTrackerSync()
  inspect -> tracker : canonical 상태 읽기
  inspect -> beads : mirror 상태 읽기
  alt 불일치 또는 조회 실패
    inspect --> gates : fail
    gates --> execute : blocked
    execute -> checkpoint : write(blocker, next_action)
    execute --> 사용자 : 파견 차단
  else 검증 통과
    gates --> execute : pass
    execute -> dispatch : workspace_root + shared_guidance_root 전달
    dispatch -> guidance : 구현·테스트 지침 읽기
    guidance --> dispatch : 적용 범위·현행 항목
    dispatch -> codex : 구현 단계 파견
    codex -> codex : plan/spec 및 공유 지침 읽기
    codex --> dispatch : 결과·실패
    dispatch --> execute : 고정점·변경 파일
    opt E2E 실행 대상
      execute -> e2e : workspace_root·shared_guidance_root·session_directory·실행 profile 전달
      e2e -> guidance : 테스트 지침 읽기
      guidance --> e2e : 적용 범위·현행 항목
      e2e -> e2e : 관련 docs/verification/e2e-lessons.md 읽기
      e2e -> session : runtime/e2e/<run_id>/ 시도별 증거 보존
      e2e --> execute : 모든 실패와 원본 evidence_path 보고
      execute -> checkpoint : tests.e2e_failures를 ID별 병합
      note over execute,checkpoint
        status만 갱신하거나 []를 전달해도 실패 이력 보존
        원본 evidence_path 변경 금지
      end note
      alt 원인 확인 및 예방 조치 가능
        execute -> execute : 실제 profile·readiness·회귀 검사 수정
        execute -> execute : 같은 원인 2회면 correct 호출
        execute -> e2e : launcher로 영향받은 사용자 경로 재검증
        e2e -> session : 새 run_id에 재검증 증거 보존
        e2e --> execute : 예방 검사·사용자 경로 결과
        execute -> execute : 검증된 lesson을 프로젝트 문서에 반영
        execute -> checkpoint : 원인·예방 조치·재검증 결과 기록
      else 원인 미상 또는 외부 장애
        execute -> checkpoint : unresolved 보존, 무조건 재시도 금지
      end
    end
    execute -> checkpoint : write(단계·test evidence)
    execute -> traceability : check(completion, source/test hash·session receipt)
    traceability --> execute : pass 또는 구현 완료 차단
    execute -> review : 독립 spec·standards review
    review -> review : 실제 재발 방지 조치와 실행 receipt 검토
    execute -> gates : tests: e2eFailuresResolved()
    note over execute,gates
      helper는 metadata 형식만 검증
      passed 요약이어도 unresolved·unknown·학습 증거 누락 시
      lifecycle tests와 wrapper 완료 차단; handoff에도 이력 유지
    end note
    alt review 지적 또는 검사 실패
      execute -> checkpoint : write(repair 필요)
      execute --> 사용자 : repair/handoff 상태
    else 구현 완료 검사 통과
      execute -> sync : syncTrackerStatus(ticket_ref, status 생략)
      sync -> tracker : GitHub Workflow Status 또는 local ticket 갱신
      sync -> tracker : canonical 재조회
      sync -> beads : 최신 canonical 상태로 갱신
      sync -> beads : 상태 재조회
      alt 부분 실패
        sync -> sync : 실패 기록, rollback 없이 재시도 정보 보존
        note right of sync
          재시도 시 status를 생략해
          최신 canonical 상태를 반영
        end note
        sync --> execute : fail
        execute --> 사용자 : 동기화 차단
      else 동기화 통과
        sync --> execute : pass
        execute -> gates : before_complete
        gates -> inspect : inspectTrackerSync()
        inspect -> tracker : canonical 상태 읽기
        inspect -> beads : mirror 상태 읽기
        alt 불일치 또는 조회 실패
          inspect --> gates : fail
          gates --> execute : blocked
          execute --> 사용자 : Done·dependents 해제 차단
        else 종료 확인 통과
          inspect --> gates : pass
          gates --> execute : pass
          execute -> complete : completeWorkflow(workflow_id, workspace_root, base_ref, state)
          complete -> complete : before_complete 및 결과 journal 기록
          complete -> finish : finally: outcome에 관계없이 정리
          complete -> session : completion journal 저장
          alt manager-owned parallel cleanup
            finish -> archive : tree·index·HEAD 보존 및 검증
            finish -> worktree : 소유 worktree 제거
          else unowned sequential cleanup
            note over complete,finish
              부모가 완료 후 cleanup; unowned workspace는 finish에서 보존
            end note
          end
          finish --> complete : removed / failed / not-owned
          complete --> execute : 결과 + worktree_cleanup
          execute -> checkpoint : write(completed)
          execute --> 사용자 : 완료·tracker reconciliation
        end
      end
    end
  end
  end
end
note over checkpoint,session
  staging·review journal·checkpoint는 session_directory에 남아
  worktree 제거 후에도 복구 가능
end note
@enduml
