<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:harness:subagent-result:v1" xmlns="urn:harness:subagent-result:v1" elementFormDefault="qualified">
  <xs:element name="subagent-result">
    <xs:complexType><xs:sequence>
      <xs:element name="identity" type="identityType"/><xs:element name="delegate" type="delegateType"/><xs:element name="outcome" type="outcomeType"/>
      <xs:element name="review" type="reviewType" minOccurs="0"/><xs:element name="verification" type="verificationType" minOccurs="0"/><xs:element name="artifacts" type="emptyType"/><xs:element name="evidence" type="evidenceType"/><xs:element name="changes" type="emptyType"/><xs:element name="blockers" type="emptyType"/>
    </xs:sequence><xs:attribute name="schemaVersion" use="required" fixed="1"/></xs:complexType>
  </xs:element>
  <xs:complexType name="identityType"><xs:attribute name="runId" type="xs:string" use="required"/><xs:attribute name="stepId" type="xs:string" use="required"/><xs:attribute name="attemptId" type="xs:string" use="required"/></xs:complexType>
  <xs:complexType name="delegateType"><xs:attribute name="agentId" type="xs:string" use="required"/><xs:attribute name="skillId" type="xs:string" use="required"/></xs:complexType>
  <xs:complexType name="outcomeType"><xs:sequence><xs:element name="summary" type="xs:string"/><xs:element name="failure" type="failureType" minOccurs="0"/></xs:sequence><xs:attribute name="status" use="required"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="succeeded"/><xs:enumeration value="failed"/><xs:enumeration value="blocked"/></xs:restriction></xs:simpleType></xs:attribute></xs:complexType>
  <xs:complexType name="failureType"><xs:sequence><xs:element name="message" type="xs:string"/><xs:element name="evidenceRef" type="xs:string" minOccurs="0" maxOccurs="unbounded"/></xs:sequence><xs:attribute name="code" type="xs:string" use="required"/><xs:attribute name="category" type="xs:string" use="required"/></xs:complexType>
  <xs:complexType name="reviewType"><xs:sequence><xs:element name="coverage" type="coverageType"/><xs:element name="findings" type="findingsType"/></xs:sequence></xs:complexType>
  <xs:complexType name="verificationType"><xs:sequence><xs:element name="subject" type="subjectType"/><xs:element name="commands" type="commandsType"/><xs:element name="violations" type="violationsType"/><xs:element name="fingerprint" type="xs:string" minOccurs="0"/></xs:sequence></xs:complexType>
  <xs:complexType name="subjectType"><xs:attribute name="planPath" type="xs:string" use="required"/><xs:attribute name="planSha256" type="xs:string" use="required"/><xs:attribute name="goalPath" type="xs:string" use="required"/><xs:attribute name="goalSha256" type="xs:string" use="required"/></xs:complexType>
  <xs:complexType name="commandsType"><xs:sequence><xs:element name="command" type="commandType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType>
  <xs:complexType name="commandType"><xs:attribute name="id" type="xs:string" use="required"/><xs:attribute name="source" type="xs:string" use="required"/><xs:attribute name="exitCode" type="xs:integer" use="required"/><xs:attribute name="stdoutPath" type="xs:string" use="required"/><xs:attribute name="stderrPath" type="xs:string" use="required"/></xs:complexType>
  <xs:complexType name="violationsType"><xs:sequence><xs:element name="violation" type="violationType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType>
  <xs:complexType name="violationType"><xs:sequence><xs:element name="message" type="xs:string"/></xs:sequence><xs:attribute name="code" type="xs:string" use="required"/><xs:attribute name="evidenceRef" type="xs:string" use="required"/></xs:complexType>
  <xs:complexType name="coverageType"><xs:sequence><xs:element name="assessed" type="assessedType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType>
  <xs:complexType name="assessedType"><xs:attribute name="criterionRef" type="xs:string" use="required"/><xs:attribute name="evidenceRef" type="xs:string" use="required"/></xs:complexType>
  <xs:complexType name="findingsType"><xs:sequence><xs:element name="finding" type="findingType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType>
  <xs:complexType name="findingType"><xs:sequence><xs:element name="message" type="xs:string"/></xs:sequence><xs:attribute name="criterionRef" type="xs:string" use="required"/><xs:attribute name="severity" type="xs:string" use="required"/><xs:attribute name="evidenceRef" type="xs:string" use="required"/></xs:complexType>
  <xs:complexType name="evidenceType"><xs:sequence><xs:element name="item" type="evidenceItemType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType>
  <xs:complexType name="evidenceItemType"><xs:attribute name="id" type="xs:string" use="required"/><xs:attribute name="path" type="xs:string" use="required"/></xs:complexType>
  <xs:complexType name="emptyType" mixed="true"/>
</xs:schema>
