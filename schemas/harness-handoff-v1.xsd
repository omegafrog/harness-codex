<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:harness:handoff:v1"
           xmlns="urn:harness:handoff:v1"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">
  <xs:complexType name="valueType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="value" type="valueType"/>
      <xs:element name="entry" type="entryType"/>
    </xs:choice>
    <xs:attribute name="kind" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="null"/>
          <xs:enumeration value="boolean"/>
          <xs:enumeration value="integer"/>
          <xs:enumeration value="number"/>
          <xs:enumeration value="string"/>
          <xs:enumeration value="list"/>
          <xs:enumeration value="map"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="entryType">
    <xs:sequence><xs:element name="value" type="valueType"/></xs:sequence>
    <xs:attribute name="key" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:element name="harness-handoff">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="data">
          <xs:complexType><xs:sequence><xs:element name="value" type="valueType"/></xs:sequence></xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="schemaVersion" use="required" fixed="1"/>
      <xs:attribute name="type" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="execution-scope"/>
            <xs:enumeration value="execution-report"/>
            <xs:enumeration value="verification-report"/>
            <xs:enumeration value="security-profile"/>
            <xs:enumeration value="security-controls"/>
            <xs:enumeration value="security-bundle-manifest"/>
            <xs:enumeration value="token-metrics"/>
            <xs:enumeration value="finalization-report"/>
            <xs:enumeration value="gate-verdict"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
</xs:schema>
