{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "skill",
    "status",
    "code",
    "summary",
    "artifacts",
    "question",
    "questions",
    "required_subtasks",
    "review_request"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "execution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "skill": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "status": {
      "enum": [
        "completed",
        "action_required",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "code": {
      "enum": [
        "OK",
        "REVIEW_REQUIRED",
        "SUBTASK_REQUIRED",
        "SPEC_REVISION_REQUIRED",
        "PLAN_REVISION_REQUIRED",
        "IMPLEMENTATION_REVISION_REQUIRED",
        "USER_DECISION_REQUIRED",
        "ENVIRONMENT_UNAVAILABLE",
        "PERMISSION_REQUIRED",
        "DEPENDENCY_INCOMPLETE",
        "INPUT_MISSING",
        "MODEL_BINDING_UNAVAILABLE",
        "EXECUTION_ERROR",
        "INVALID_INPUT",
        "ARTIFACT_WRITE_FAILED",
        "CANCELLED"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "base",
          "path",
          "kind",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "base": {
            "enum": [
              "workspace",
              "session",
              "control_session"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "question": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "question_id",
            "question",
            "options",
            "recommended_option_id",
            "rationale"
          ],
          "properties": {
            "question_id": {
              "type": "string",
              "minLength": 1
            },
            "question": {
              "type": "string",
              "minLength": 1
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "label",
                  "consequence"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "consequence": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "recommended_option_id": {
              "type": "string",
              "minLength": 1
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "question",
          "options",
          "recommended_option_id",
          "rationale"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "consequence"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "consequence": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "recommended_option_id": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "required_subtasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill",
          "role",
          "purpose"
        ],
        "properties": {
          "skill": {
            "type": "string"
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "review_request": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skill",
            "role",
            "purpose",
            "context_path"
          ],
          "properties": {
            "skill": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "purpose": {
              "type": "string"
            },
            "context_path": {
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
