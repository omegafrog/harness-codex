#!/bin/sh
if [ -n "$CODEX_CALL_LOG" ]; then printf '%s\n' "$*" >> "$CODEX_CALL_LOG"; fi
if [ "$1" = "plugin" ] && [ "$2" = "marketplace" ] && [ "$3" = "list" ]; then
  printf '{"marketplaces":[]}\n'
elif [ "$1" = "plugin" ] && [ "$2" = "list" ]; then
  printf '{"installed":[]}\n'
else
  printf '{}\n'
fi
