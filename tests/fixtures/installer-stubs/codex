#!/bin/sh
if [ -n "$CODEX_CALL_LOG" ]; then printf '%s\n' "$*" >> "$CODEX_CALL_LOG"; fi
if [ "$1" = "plugin" ] && [ "$2" = "marketplace" ] && [ "$3" = "list" ]; then
  printf '{"marketplaces":[]}\n'
elif [ "$1" = "plugin" ] && [ "$2" = "list" ]; then
  printf '{"installed":[]}\n'
elif [ "$1" = "app-server" ]; then
  exec python3 -u -c '
import sys,json
for line in sys.stdin:
    request=json.loads(line)
    if "id" not in request: continue
    result={"data":[{"id":"fixture-model","description":"fixture model","supportedReasoningEfforts":[{"reasoningEffort":"low","description":"fixture effort"}]}]} if request.get("method")=="model/list" else {}
    print(json.dumps({"id":request["id"],"result":result}),flush=True)
'
else
  printf '{}\n'
fi
