{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "plan_set_id",
    "reviewer_id",
    "author_ids",
    "fork_turns",
    "verdict",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_set_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "author_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fork_turns": {
      "const": "none"
    },
    "verdict": {
      "enum": [
        "pass",
        "revise"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "description",
          "evidence"
        ],
        "properties": {
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
