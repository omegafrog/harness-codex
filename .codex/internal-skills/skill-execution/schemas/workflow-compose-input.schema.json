{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "context"
  ],
  "properties": {
    "context": {
      "type": "object",
      "required": [
        "worktree_ref",
        "stage_id"
      ],
      "properties": {
        "worktree_ref": {
          "type": "string",
          "minLength": 1
        },
        "stage_id": {
          "const": "workflow-compose"
        }
      }
    }
  }
}
