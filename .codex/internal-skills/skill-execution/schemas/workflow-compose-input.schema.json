{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "context"
  ],
  "properties": {
    "context": {
      "type": "object",
      "required": [
        "worktree_ref",
        "codex_session_id",
        "stage_id"
      ],
      "properties": {
        "worktree_ref": {
          "type": "string",
          "minLength": 1
        },
        "codex_session_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "stage_id": {
          "const": "workflow-compose"
        }
      }
    }
  }
}
