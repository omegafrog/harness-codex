{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "skill",
    "scope",
    "input_refs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "execution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "skill": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "workspace_root": {
      "type": "string",
      "minLength": 1
    },
    "session_directory": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "base",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "base": {
            "enum": [
              "workspace",
              "session",
              "control_session"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "worktree_ref": { "type": "string", "minLength": 1 },
        "plan_set_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "codex_session_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
        "stage_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
        "resume_session_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
        "agent_profile": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
        "role": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
        "transition": {
          "type": "object",
          "required": ["from_stage", "code", "result_ref", "summary"],
          "additionalProperties": false,
          "properties": {
            "from_stage": { "type": "string", "minLength": 1 },
            "code": { "type": "string", "minLength": 1 },
            "result_ref": { "type": "string", "minLength": 1 },
            "summary": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
