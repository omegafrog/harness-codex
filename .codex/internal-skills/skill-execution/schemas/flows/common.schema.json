{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "skill",
    "status",
    "code",
    "summary",
    "artifacts",
    "questions",
    "review_request"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "execution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "skill": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "status": {
      "enum": [
        "completed",
        "action_required",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "code": {
      "enum": [
        "OK",
        "REVIEW_REQUIRED",
        "SPEC_REVISION_REQUIRED",
        "PLAN_REVISION_REQUIRED",
        "IMPLEMENTATION_REVISION_REQUIRED",
        "USER_DECISION_REQUIRED",
        "ENVIRONMENT_UNAVAILABLE",
        "PERMISSION_REQUIRED",
        "DEPENDENCY_INCOMPLETE",
        "INPUT_MISSING",
        "MODEL_BINDING_UNAVAILABLE",
        "EXECUTION_ERROR",
        "INVALID_INPUT",
        "ARTIFACT_WRITE_FAILED",
        "CANCELLED"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "base",
          "path",
          "kind",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "base": {
            "enum": [
              "workspace",
              "session",
              "control_session"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "title",
          "options",
          "recommended_option_id",
          "rationale"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "consequence"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "consequence": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "description": "Why this option meets or misses each criterion, citing a stored knowledge Claim from an authoritative source. Empty for a non-technology question.",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "criterion",
                      "result",
                      "claim_id",
                      "source_title",
                      "url",
                      "checked_at"
                    ],
                    "properties": {
                      "criterion": {
                        "type": "string",
                        "minLength": 1
                      },
                      "result": {
                        "type": "string",
                        "enum": [
                          "met",
                          "unmet",
                          "unknown"
                        ]
                      },
                      "claim_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source_title": {
                        "type": "string",
                        "minLength": 1
                      },
                      "url": {
                        "type": "string",
                        "minLength": 1
                      },
                      "checked_at": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "recommended_option_id": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "decision_kind": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "technology",
              null
            ],
            "description": "technology for a technical choice (every option then carries evidence citing stored knowledge Claims); null otherwise."
          }
        }
      }
    },
    "review_request": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skill",
            "role",
            "purpose",
            "context_path"
          ],
          "properties": {
            "skill": {
              "type": "string"
            },
            "role": {
              "type": [
                "string",
                "null"
              ]
            },
            "purpose": {
              "type": "string"
            },
            "context_path": {
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "unplanned_additions": {
      "type": "array",
      "description": "Behavior in this implementation that does not trace to an approved requirement ID. Use an empty array when there is none.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "summary",
          "evidence",
          "benefit",
          "cost",
          "rule_impact",
          "plain_explanation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "benefit": {
            "type": "string",
            "minLength": 1
          },
          "cost": {
            "type": "string",
            "minLength": 1
          },
          "rule_impact": {
            "enum": [
              "none",
              "business_rule"
            ],
            "description": "none only when the change adds no business rule, limit, validation, state or data behavior."
          },
          "plain_explanation": {
            "type": "string",
            "minLength": 1,
            "description": "One plain sentence a non-specialist can use to decide."
          }
        }
      }
    },
    "commit_request": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "message",
        "paths"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "Do not run git commit. The runner commits exactly these paths after the stage ends. Null when nothing should be committed."
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    }
  }
}
