{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "skill",
    "status",
    "code",
    "summary",
    "artifacts",
    "questions",
    "review_request"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "execution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "skill": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "status": {
      "enum": [
        "completed",
        "action_required",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "code": {
      "enum": [
        "OK",
        "REVIEW_REQUIRED",
        "SPEC_REVISION_REQUIRED",
        "PLAN_REVISION_REQUIRED",
        "IMPLEMENTATION_REVISION_REQUIRED",
        "USER_DECISION_REQUIRED",
        "ENVIRONMENT_UNAVAILABLE",
        "PERMISSION_REQUIRED",
        "DEPENDENCY_INCOMPLETE",
        "INPUT_MISSING",
        "MODEL_BINDING_UNAVAILABLE",
        "EXECUTION_ERROR",
        "INVALID_INPUT",
        "ARTIFACT_WRITE_FAILED",
        "CANCELLED"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "base",
          "path",
          "kind",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "base": {
            "enum": [
              "workspace",
              "session",
              "control_session"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "title",
          "options",
          "recommended_option_id",
          "rationale"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "object",
            "description": "What the user needs to decide without following the agent's work. Required of every new question; earlier stored questions may omit it.",
            "additionalProperties": false,
            "required": [
              "settled_rules",
              "why_now"
            ],
            "properties": {
              "settled_rules": {
                "type": "array",
                "minItems": 1,
                "description": "Already-settled business rules that bear on this decision, quoted from settled documents or answers; never a new rule.",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "why_now": {
                "type": "string",
                "minLength": 1,
                "description": "Why this must be decided now."
              }
            }
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "consequence"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "consequence": {
                  "type": "string",
                  "minLength": 1
                },
                "effect": {
                  "type": "string",
                  "minLength": 1,
                  "description": "What this option changes on screen or in behavior. Required of every option of a new question."
                },
                "example": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The same concrete situation applied to this option, for example two pins of one owner on a map; illustrative, never a requirement; differs per option. Required of every option of a new question."
                },
                "evidence": {
                  "type": "array",
                  "description": "Why this option meets or misses each criterion, citing a stored knowledge Claim from an authoritative source. Empty for a non-technology question.",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "criterion",
                      "result",
                      "claim_id",
                      "source_title",
                      "url",
                      "checked_at"
                    ],
                    "properties": {
                      "criterion": {
                        "type": "string",
                        "minLength": 1
                      },
                      "result": {
                        "type": "string",
                        "enum": [
                          "met",
                          "unmet",
                          "unknown"
                        ]
                      },
                      "claim_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source_title": {
                        "type": "string",
                        "minLength": 1
                      },
                      "url": {
                        "type": "string",
                        "minLength": 1
                      },
                      "checked_at": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "previews": {
                  "type": "array",
                  "description": "Session-relative screenshots of this option rendered as a static style mock. A visual_direction question needs at least a desktop and a mobile preview on every option; empty for other questions.",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "viewport",
                      "caption"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Image path relative to the session directory, for example runtime/executions/<execution_id>/style-options/<option_id>/desktop.png"
                      },
                      "viewport": {
                        "type": "string",
                        "enum": [
                          "desktop",
                          "tablet",
                          "mobile"
                        ]
                      },
                      "caption": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "recommended_option_id": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "decision_kind": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "technology",
              "visual_direction",
              null
            ],
            "description": "technology for a technical choice (every option then carries evidence citing stored knowledge Claims); visual_direction for a visual style choice (every option then carries desktop and mobile previews and the title names the comparison page); null otherwise."
          }
        }
      }
    },
    "review_request": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skill",
            "role",
            "purpose",
            "context_path"
          ],
          "properties": {
            "skill": {
              "type": "string"
            },
            "role": {
              "type": [
                "string",
                "null"
              ]
            },
            "purpose": {
              "type": "string"
            },
            "context_path": {
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "unplanned_additions": {
      "type": "array",
      "description": "Behavior in this implementation that does not trace to an approved requirement ID. Use an empty array when there is none.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "summary",
          "evidence",
          "benefit",
          "cost",
          "rule_impact",
          "plain_explanation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "benefit": {
            "type": "string",
            "minLength": 1
          },
          "cost": {
            "type": "string",
            "minLength": 1
          },
          "rule_impact": {
            "enum": [
              "none",
              "business_rule"
            ],
            "description": "none only when the change adds no business rule, limit, validation, state or data behavior."
          },
          "plain_explanation": {
            "type": "string",
            "minLength": 1,
            "description": "One plain sentence a non-specialist can use to decide."
          }
        }
      }
    },
    "commit_request": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "message",
        "paths"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "Do not run git commit. The runner commits exactly these paths after the stage ends. Null when nothing should be committed."
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "owner_stage": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "description": "Required for blocked / DEPENDENCY_INCOMPLETE in a design or ticket stage: the id of the earliest earlier flow stage whose output is missing or insufficient. The runner reopens that stage and walks forward again. null otherwise."
    },
    "dependency_gap": {
      "type": [
        "string",
        "null"
      ],
      "description": "Required with owner_stage: what the owner stage must add or change (the missing operation, call, row or decision and the evidence). null otherwise."
    },
    "published_issues": {
      "type": "array",
      "description": "tracker-publish only: every repository Issue the publication created or confirmed, the parent as plan_id @parent. Issue URLs are not file artifacts; never list them in artifacts. [] in local-markdown mode.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan_id",
          "url"
        ],
        "properties": {
          "plan_id": {
            "type": "string",
            "pattern": "^(@parent|[A-Za-z0-9][A-Za-z0-9._-]*)$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://github\\.com/[\\w.-]+/[\\w.-]+/issues/[1-9][0-9]*$"
          }
        }
      }
    }
  }
}
